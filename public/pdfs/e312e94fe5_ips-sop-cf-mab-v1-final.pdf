/* Main accordion wrapper */
.wp-block-themeisle-blocks-accordion {
  --title-color: var(--nv-primary-accent);
  --title-background: var(--nv-site-bg);
  --border-color: var(--nv-dark-bg);
  --gap: 5px;
}

/* Open (expanded) state */
.wp-block-themeisle-blocks-accordion > .wp-block-themeisle-blocks-accordion-item[open] {
  --title-color: var(--nv-secondary-accent);
  --title-background: #eee;
}

/* Accordion title text */
.wp-block-themeisle-blocks-accordion 
> .wp-block-themeisle-blocks-accordion-item 
> .wp-block-themeisle-blocks-accordion-item__title 
> * {
  font-size: 18px;

